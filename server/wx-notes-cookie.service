[Unit]
Description=Maintain Yuanbao Cookie and report failures
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/projects/wx-video-account-notes
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/projects/wx-video-account-notes/.runtime/server/browsers
ExecStart=/root/projects/wx-video-account-notes/.runtime/server/.venv/bin/python /root/projects/wx-video-account-notes/maintain_cookie.py
TimeoutStartSec=10min
UMask=0077
